rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && 
             (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.adminRole == 'admin' ||
              firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.adminRole == 'super' ||
              firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
              firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true);
    }

    // Session Background Images
    match /session_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Celebration Images
    match /celebration_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Exercise images — admin only (from live)
    match /exercises/{exerciseId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Profile pictures — users can upload their own only (from live)
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId;
    }
  }
}
