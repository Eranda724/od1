rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Session Background Images
    match /session_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Exercise images — admin only (from live)
    match /exercises/{exerciseId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Profile pictures — users can upload their own only (from live)
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId;
    }
  }
}
