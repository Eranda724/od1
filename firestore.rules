rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', '') == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true);
    }

    function isSuperAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', '') == 'super' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSuperAdmin', false) == true);
    }

    // Anyone signed in can read the exercise catalog, only admins/super-admins can write
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isSuperAdmin();
    }

    // App config (e.g. notifications) — all users can read, only admins write
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isSuperAdmin();
    }

    // Admins collection itself — no one can write to it from the client
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      // Must be logged in to read user data
      allow read: if request.auth != null;
      
      // Allow user to create their own document, but not escalate privileges
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.get('isAdmin', false) == false
                    && request.resource.data.get('isSuperAdmin', false) == false
                    && request.resource.data.get('isPremium', false) == false;

      // Super admins can update ANY user document freely (isPremium, isAdmin, adminRole, etc.)
      allow update: if isSuperAdmin();

      // Admins can update any user, and Regular users can update their own doc. 
      // However, neither can change privilege fields (only superadmins can).
      allow update: if (isAdmin() || (request.auth != null && request.auth.uid == userId))
                    && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
                    && request.resource.data.get('isSuperAdmin', false) == resource.data.get('isSuperAdmin', false)
                    && request.resource.data.get('isPremium', false) == resource.data.get('isPremium', false)
                    && request.resource.data.get('adminRole', '') == resource.data.get('adminRole', '');
      
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Specific rules for inAppNotifications
      match /inAppNotifications/{notificationId} {
        // Owner can read and update their own notifications
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        // Any authenticated user can send a notification to anyone
        allow create: if request.auth != null;
      }
      
      match /{document=**} {
        allow read: if request.auth != null;
        // Owner can write their own subcollections; super admins and admins can write any
        allow write: if (request.auth != null && request.auth.uid == userId)
                     || isSuperAdmin() || isAdmin();
      }
    }
    match /friendPairs/{pairId} {
      // Only users involved in the pair can read or modify it
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.uids);
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.uids;
    }

    match /friendRequests/{requestId} {
      // Sender or receiver can read and delete
      allow read, delete: if request.auth != null && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      // Only sender can create
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
      // Sender or receiver can update (typically receiver to accept, sender if they withdraw)
      allow update: if request.auth != null && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }
  }
}
